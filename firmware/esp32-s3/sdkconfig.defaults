# Stage-1 (Part A only): private-API CCMP join, NO raw TX. See gba-switch-bridge/docs/14.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_LDN_PROBE_CHANNEL=6
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_LDN_PROBE_PRIVATE_JOIN=y
CONFIG_LDN_PROBE_EXPORT_ADVERTISEMENTS=y
CONFIG_LDN_PROBE_CONTROL_PORT=y
CONFIG_LDN_PROBE_LEGACY_PHY=y
CONFIG_LWIP_DHCPS_STATIC_ENTRIES=y
CONFIG_LDN_PROBE_PRIVATE_RAW_TX=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
# ESP32-S3-WROOM-1 N8R8: 8MB octal PSRAM. Enables zstd (~94KB) + Wi-Fi buffers to live in
# external RAM instead of the ~220KB internal SRAM.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y

# Higher tick rate so the ~2ms main-loop yield is real (was 0 ticks at 100Hz -> IDLE wdt flood)
CONFIG_FREERTOS_HZ=1000

# 240MHz CPU: the gba_spi bit-bang timing (CLK_GIVEUP, tight edge waits) is calibrated for 240MHz.
# `idf.py set-target` regenerates sdkconfig from THIS file, and the IDF default is only 160MHz — which
# regressed GBA adapter detection. Pin it here so a future set-target can't silently drop us to 160.
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# The core-1 GBA bit-bang spins with interrupts off, waiting on the GBA's clock — exactly like the
# RP2040's bare, watchdog-free core-1 loop. The GBA paces RFU commands per-VBlank and pauses for the
# 1-2s room-entry animation, so a legit clock gap can exceed the interrupt watchdog. Exempt CPU1 from
# the interrupt + idle-task watchdogs so those pauses don't reboot us; the sample loops stay counter-free
# (a counter in the hot path shifts the bit read — the RP2040's 0x494E->0x929C lesson). CPU0 keeps both.
CONFIG_ESP_INT_WDT_CHECK_CPU1=n
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# HARD REAL-TIME core1: FreeRTOS (tick/scheduler/IPC) runs ONLY on core0; core1 is left empty and we
# wake it manually into a bare, non-preemptible bit-bang loop (gba_core1.c) — the RP2040 model. This is
# what removes the last ~1-in-700 mid-word ISR jitter that kicks us out of the room. (branch
# hard-realtime-core1; core0 still runs the LDN/Switch side + shared-SRAM inter-core comms.)
CONFIG_FREERTOS_UNICORE=y
